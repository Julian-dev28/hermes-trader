# Keep the build context small and secret-free.

# VCS / CI
.git
.gitignore
.github

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs
.venv/
venv/
env/

# Local secrets / config — never bake into an image
.env
.env.*
*.pem
*.key

# Deployment manifests aren't needed inside the image
deploy/
docker-compose.yml
Dockerfile
.dockerignore

# Tests aren't shipped in the runtime image
tests/

# Local DBs / editor junk
*.sqlite
*.db
.DS_Store
.idea/
.vscode/
